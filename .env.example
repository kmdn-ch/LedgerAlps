# ─── LedgerAlps — Configuration ──────────────────────────────────────────────
# Utile uniquement pour le développement ou un déploiement serveur.
#
# En usage normal (installeur Windows), vous n'avez PAS besoin de ce fichier :
# l'assistant de premier démarrage écrit la configuration dans
# %APPDATA%\LedgerAlps\config.json.
#
# Copier pour démarrer :  cp .env.example .env
# Ne jamais committer le fichier .env.
#
# ATTENTION : si le fichier config.json existe, il a la PRIORITÉ sur ces
# variables d'environnement. Pour cibler une base précise en ligne de commande,
# passez plutôt --sqlite-path à ledgeralps-cli.

# ─── Sécurité ─────────────────────────────────────────────────────────────────
# Obligatoire. 32 caractères minimum : le serveur refuse de démarrer en dessous,
# ou si la valeur figure dans la liste des secrets faibles connus.
# Générer :  openssl rand -hex 32
JWT_SECRET=

# ─── Base de données ──────────────────────────────────────────────────────────
# Par défaut SQLite (mode WAL) — c'est le mode local-first recommandé.
SQLITE_PATH=ledgeralps.db

# Pour PostgreSQL, renseigner ce DSN : il prend alors le pas sur SQLITE_PATH.
# POSTGRES_DSN=postgres://ledgeralps:motdepasse@localhost:5432/ledgeralps

# ─── Serveur ──────────────────────────────────────────────────────────────────
# Interface d'écoute. Par défaut 127.0.0.1 : LedgerAlps n'est joignable que
# depuis cette machine, et le trafic ne touche aucun câble.
#
# Jusqu'à la v1.4.5 le serveur écoutait sur TOUTES les interfaces : un portable
# sur un réseau public y servait sa comptabilité en clair, sans que personne
# l'ait demandé. Rendre LedgerAlps joignable depuis un autre poste est
# désormais un choix — et ce choix impose TLS.
HOST=127.0.0.1
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# Origines CORS autorisées, séparées par des virgules.
# En développement, le serveur Vite tourne sur le port 5173.
ALLOWED_ORIGINS=http://localhost:5173

# ─── Vérification de mise à jour ──────────────────────────────────────────────
# Unique appel réseau sortant de LedgerAlps : demande à GitHub s'il existe une
# version plus récente, afin de signaler les correctifs de conformité.
# Aucun identifiant, aucune donnée utilisateur transmise. Résultat mis en cache
# 24 h, échec silencieux. Mettre à false pour une installation isolée du réseau.
UPDATE_CHECK=true

# ─── Sauvegardes chiffrées ────────────────────────────────────────────────────
# Chiffre les instantanés (Argon2id + XChaCha20-Poly1305). Les sauvegardes sont
# la copie qui *quitte* la machine — NAS, clé USB — donc la plus exposée
# (nLPD art. 8, OPDo art. 1-6).
#
# Choisissez une phrase de passe DISTINCTE du mot de passe de session : sinon,
# perdre le poste revient à perdre aussi les sauvegardes. Conservez-la ailleurs
# que sur cette machine — sans elle, aucun instantané n'est récupérable, par
# personne, vous compris.
#
# Laisser vide produit des sauvegardes en clair (comportement actuel).
# BACKUP_PASSPHRASE=

# ─── TLS ──────────────────────────────────────────────────────────────────────
# Dès que HOST n'est pas loopback, LedgerAlps sert en HTTPS. Fournissez votre
# certificat, sinon il en génère un auto-signé (le navigateur avertira une fois).
# TLS_CERT=/etc/ledgeralps/cert.pem
# TLS_KEY=/etc/ledgeralps/key.pem
#
# Servir en clair sur une interface réseau. Un seul cas légitime : un reverse
# proxy termine déjà TLS sur la même machine. Sinon, mot de passe de connexion,
# jeton de session et phrase de passe de sauvegarde traversent le réseau en
# clair (LPD art. 8, OPDo art. 3).
# ALLOW_INSECURE_HTTP=false
